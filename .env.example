# ========== REQUIRED ==========
DATABASE_URL=postgresql://user:pass@host:5432/railway
SESSION_SECRET=generate-with-openssl-rand-base64-32
APP_URL=http://localhost:5173
API_URL=http://localhost:4000
PORT=4000
WORKER_PORT=4001
NODE_ENV=development
STORAGE_PATH=./data
# On Railway volume use: STORAGE_PATH=/var/data

# ========== DEVELOPER PASS (no Google) ==========
# Set both to enable login form on /login
DEV_AUTH_EMAIL=admin@mti.local
DEV_AUTH_PASSWORD=change-me-strong-pass
DEV_AUTH_NAME=Admin

# ========== GOOGLE (optional until you need OAuth / Gmail sync) ==========
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback
ALLOWED_EMAIL_DOMAINS=mti.co.kr,gmail.com

# Shared org Gmail (after OAuth once, or paste refresh token)
GMAIL_REFRESH_TOKEN=
GMAIL_USER=

# ========== LLM / agents (Worker service) ==========
# Get key: https://openrouter.ai/keys
# Local: set here. Railway: Worker Variables (API optional for health only).
OPENROUTER_API_KEY=
# Main orchestrator (paid) — Claude Haiku 4.5 via OpenRouter
OPENROUTER_MAIN_MODEL=anthropic/claude-haiku-4.5
# Free sub-agents (comma-separated). Used intensively for research/draft/critique.
OPENROUTER_SUB_MODELS=meta-llama/llama-3.3-70b-instruct:free,google/gemma-3-27b-it:free,mistralai/mistral-small-3.1-24b-instruct:free
# Deprecated alias: if MAIN unset, falls back to this
OPENROUTER_WORKER_MODEL=anthropic/claude-haiku-4.5
WORKER_MAX_CONCURRENT=3
WORKER_SUBAGENT_CONCURRENCY=3
# Inner think→act→review loops per DB claim before releasing (keeps other projects fair)
WORKER_ITERS_PER_CLAIM=5
# Retries on OpenRouter 429 / rate limit before hard stop_reason=rate_limit
OPENROUTER_MAX_RETRIES=3
# Optional later
ANTHROPIC_API_KEY=
TAVILY_API_KEY=

DATABASE_SSL=false
