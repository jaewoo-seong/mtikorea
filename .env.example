# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=<generate-with-openssl-rand-base64-32>

# Google OAuth
GOOGLE_CLIENT_ID=<from-google-cloud>
GOOGLE_CLIENT_SECRET=<from-google-cloud>

# PostgreSQL (Railway)
DATABASE_URL=postgresql://<user>:<password>@<railway-host>:<port>/<database>

# File Storage (Railway persistent volume; falls back to ./var-data locally)
STORAGE_PATH=/var/data

# OpenRouter — used for both orchestration and sub-agent calls (single
# provider covers both roles from the original two-provider spec)
OPENROUTER_API_KEY=<from-openrouter>
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
OPENROUTER_SUBAGENT_MODEL=anthropic/claude-haiku-4.5

# Gmail API (email sync — same credentials as Google OAuth above)
GMAIL_CLIENT_ID=<same-as-google-oauth>
GMAIL_CLIENT_SECRET=<same-as-google-oauth>

# Tavily (grounds orchestrator/sub-agent calls with live web search; degrades
# gracefully to "no browsing" when unset)
TAVILY_API_KEY=<from-tavily>

# Environment
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Dev-only Google-OAuth-bypass login. Must be explicitly true (on top of
# NODE_ENV != production) for the dev sign-in button to register — never set
# this in any deployed/shared/staging environment.
ALLOW_DEV_LOGIN=true
